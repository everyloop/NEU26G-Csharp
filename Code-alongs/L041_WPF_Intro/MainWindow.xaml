<Window x:Class="L041_WPF_Intro.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:L041_WPF_Intro"
        mc:Ignorable="d"
        FontSize="20"
        d:Height="500" d:Width="500" d:FontSize="40"
        Title="MainWindow" Height="450" Width="800"
>
    <Grid>
        <Button
            x:Name="MyButton"
            HorizontalAlignment="Center" 
            VerticalAlignment="Top"
            Click="Button_Click"
            Content="Test!"
        />

        <Button 
            x:Name="MyOtherButton"
            VerticalAlignment="Center"
            Click="Button_Click"
        >
            <Button.Content>hello</Button.Content>
            <Button.HorizontalAlignment>Center</Button.HorizontalAlignment>
        </Button>

        <Button HorizontalAlignment="Center" VerticalAlignment="Bottom">
            <StackPanel Orientation="Vertical">
                <Image Width="50" Source="https://ardalis.com/img/csharp_logo.png" />
                <Label>Knapp</Label>
                <Image Width="50" Source="https://ardalis.com/img/csharp_logo.png" />
            </StackPanel>
        </Button>

    </Grid>
</Window>

