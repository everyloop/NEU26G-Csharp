<Window x:Class="L049_Windows_in_MVVM.SettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:L049_Windows_in_MVVM"
        mc:Ignorable="d"
        ResizeMode="NoResize" WindowStyle="ToolWindow"
        Title="SettingsDialog" Height="120" Width="200">
    <Grid>
        <StackPanel>
            <Label 
                Content="ButtonText:" 
            />

            <TextBox 
                x:Name="textBox"
                Text="{Binding ButtonName, UpdateSourceTrigger=PropertyChanged}"
                Margin="10 0 10 10"
            />

            <Button 
                Content="OK"
                HorizontalAlignment="Center"
                Click="Button_Click"
                IsDefault="True"
            />
        </StackPanel>
    </Grid>
</Window>
