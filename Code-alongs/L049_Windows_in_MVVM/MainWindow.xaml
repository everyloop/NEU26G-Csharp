<Window x:Class="L049_Windows_in_MVVM.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:L049_Windows_in_MVVM"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Grid.Resources>
            <BooleanToVisibilityConverter x:Key="boolToVisibility" />
        </Grid.Resources>
        <StackPanel>
            <Button
                d:Content="Click me!"
                Content="{Binding ButtonName}"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Command="{Binding OpenSettingsCommand}"
                Visibility="{Binding IsChecked, ElementName=myCheckBox, Converter={StaticResource boolToVisibility}}"
            />
            <!--<TextBox Margin="5" TabIndex="2"/>
            <TextBox Margin="5" TabIndex="1"/>
            <TextBox Margin="5" IsTabStop="False"/>
            <TextBox Margin="5" TabIndex="3"/>
            <TextBox Margin="5" TabIndex="4"/>-->

            <CheckBox x:Name="myCheckBox" Content="Show Button" IsChecked="True" />
            
            <Button 
                Content="Async Demo Command" 
                HorizontalAlignment="Center" 
                Command="{Binding AsyncDemoCommand}"
            />
        </StackPanel>
    </Grid>
</Window>
