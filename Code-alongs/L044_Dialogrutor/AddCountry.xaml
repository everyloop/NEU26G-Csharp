<Window x:Class="L044_Dialogrutor.AddCountry"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:L044_Dialogrutor"
        mc:Ignorable="d"
        Title="AddCountry" Height="180" Width="150" ResizeMode="NoResize">
    <StackPanel>
        <Label Content="Country:" />
        <TextBox x:Name="countryTextBox" Margin="10 0"/>
        <Label Content="Capital:" />
        <TextBox x:Name="capitalTextBox" Margin="10 0"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <Button Content="Cancel" Width="50" Margin="10 20" Click="CancelButton_Click" />
            <Button Content="OK" Width="50" Margin="10 20" Click="OkButton_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
