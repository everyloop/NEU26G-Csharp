<Window x:Class="L044_Dialogrutor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:L044_Dialogrutor"
        mc:Ignorable="d"
        Title="MainWindow" Height="800" Width="400">

    <StackPanel>
        <Button Content="Show MessageBox" Margin="10 10 10 0" Click="MessageBoxButton_Click"/>
        <Button x:Name="YesNoButton" Content="Yes / No" Margin="10 10 10 0" Click="Button_Click"/>
        <Button x:Name="saveFileButton" Content="Save file" Margin="10 10 10 0" Click="SaveFileButton_Click"/>
        <Button x:Name="openFileButton" Content="Open file" Margin="10 10 10 0" Click="openFileButton_Click"/>
        <Button Content="Add New Country" Margin="10 10 10 0" Click="AddCountryButton_Click" />
        <ListBox x:Name="countryListBox" Height="200" Margin="10 10 10 0" />
    </StackPanel>
</Window>
